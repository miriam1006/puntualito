# Supabase (proyecto nuevo, exclusivo para esta app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Correo autorizado para crear el primer comercio
OWNER_EMAIL=

# Origen del despliegue, sin barra final. Local: http://localhost:3000
APP_URL=http://localhost:3000

# Pey: API key NUEVA con su propio webhook (una key = un webhook)
PEY_API_KEY=
# Puede quedar vacía: el primer webhook firmado lo escribe en los logs ("apiKeyId recibido: ...")
PEY_API_KEY_ID=
PEY_WEBHOOK_SECRET=

# Secreto del cron diario (/api/cron/generate-dues). Vercel lo manda como "Authorization: Bearer ...".
# Genera uno largo y al azar, por ejemplo: openssl rand -hex 32
CRON_SECRET=

# Tope de seguridad por cobro mientras se prueba en producción (centavos). 1 = $0.01
PEY_MAX_AMOUNT_CENTS=1

# WhatsApp Cloud API (Meta). Si falta el número o el token, no se envía nada y queda el botón wa.me.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App Secret de la app de Meta: firma X-Hub-Signature-256 del webhook
WHATSAPP_APP_SECRET=
# Texto que inventas tú y pegas también en Meta al registrar el webhook
WHATSAPP_VERIFY_TOKEN=
# Nombres de plantillas aprobadas en Meta (ver README)
WHATSAPP_TEMPLATE_NEW_DUE=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
